{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "later-gator",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TIMEZONE": "UTC"
  },
  "secrets": {
    "required": ["BOOTSTRAP_PASSWORD"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "later-gator",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THUMBNAILS",
      "bucket_name": "later-gator-thumbnails"
    }
  ],
  "images": { "binding": "IMAGES" },
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "BACKGROUND_QUEUE", "queue": "later-gator-background" }
    ],
    "consumers": [
      {
        "queue": "later-gator-background",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  }
}
