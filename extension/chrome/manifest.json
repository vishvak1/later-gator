{
  "manifest_version": 3,
  "name": "Later Gator",
  "version": "6.0.0",
  "description": "Save the current page to your private Later Gator library.",
  "permissions": ["activeTab", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "action": {
    "default_title": "Save to Later Gator",
    "default_popup": "popup.html"
  }
}
