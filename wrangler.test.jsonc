{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "later-gator-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "test",
    "TIMEZONE": "UTC",
    "BOOTSTRAP_PASSWORD": "test-pass"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "later-gator-test",
      "database_id": "local-test-database",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "THUMBNAILS",
      "id": "local-test-thumbnails"
    }
  ],
  "assets": {
    "directory": "./web/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "BACKGROUND_QUEUE", "queue": "later-gator-test-background" },
      { "binding": "THUMBNAIL_QUEUE", "queue": "later-gator-test-thumbnails" }
    ]
  }
}
