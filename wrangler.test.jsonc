{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "later-gator-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "test",
    "TIMEZONE": "UTC",
    "BOOTSTRAP_PASSWORD": "test-pass"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "later-gator-test",
      "database_id": "local-test-database",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "THUMBNAILS",
      "id": "local-test-thumbnails"
    }
  ],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "BACKGROUND_QUEUE", "queue": "later-gator-test-background" }
    ],
    "consumers": [
      {
        "queue": "later-gator-test-background",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  }
}
